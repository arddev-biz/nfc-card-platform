# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nfc_card_platform?schema=public"

# Standard Next.js environment flag.
NODE_ENV="development"

# Public base URL used to build absolute NFC card URLs shown in the admin
# UI (e.g. https://yourbusiness.al). Optional in local development —
# defaults to http://localhost:3000 if unset. Set this to your real
# domain before physically programming any NFC cards.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob storage token, used for business logo/cover image uploads.
# Get one at https://vercel.com/dashboard -> Storage -> Create -> Blob
# (works even before deploying the app itself). Without this set, image
# uploads will fail — everything else in the app works fine without it.
BLOB_READ_WRITE_TOKEN=""

# Optional: slug of a real business (created via the admin) to link to
# from the landing page's "see a real profile" section. Leave unset to
# show a static illustration instead — never insert fake demo data into
# the database just to have something to link to.
NEXT_PUBLIC_DEMO_BUSINESS_SLUG=""
